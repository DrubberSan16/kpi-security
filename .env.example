# ------------------------------------------------------------------------------
# KPI SECURITY - ENVIRONMENT
# ------------------------------------------------------------------------------
# Backend
NODE_ENV=production
PORT=3000
BASE_PATH=/kpi_security

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASS=change_me
DB_NAME=kpi_justice
DB_SSL=false

# ------------------------------------------------------------------------------
# AUTH
# ------------------------------------------------------------------------------
JWT_SECRET=change_me
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# ------------------------------------------------------------------------------
# INTERNAL SERVICES
# ------------------------------------------------------------------------------
# Secreto compartido con los backends que llaman a este servicio sin usuario
# (kpi-maintenance, kpi-inventory). Solo habilita las rutas marcadas con
# @AllowInternalService: crear log transaccional y consultar el arbol de menus.
# Debe ser identico en el .env de cada servicio que lo consume; vacio = deshabilitado.
INTERNAL_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
# CORREO DE BIENVENIDA
# ------------------------------------------------------------------------------
# URL publica del frontend. Se usa para el boton "Ingresar" del correo.
PUBLIC_BASE_URL=https://tu-dominio.com/app

# Remitente. Puede reutilizarse el mismo buzon que las alertas de mantenimiento.
WELCOME_EMAIL_FROM=tu_cuenta@gmail.com
WELCOME_EMAIL_FROM_NAME=Justice KPI

# SMTP. Si se omite, el alta de usuario sigue funcionando y solo se registra un
# aviso en el log: el correo nunca bloquea la creacion del usuario.
WELCOME_SMTP_HOST=smtp.gmail.com
WELCOME_SMTP_PORT=587
WELCOME_SMTP_SECURE=false
WELCOME_SMTP_USER=tu_cuenta@gmail.com
WELCOME_SMTP_PASS=tu_app_password_de_16_caracteres
